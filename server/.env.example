DATABASE_URL=postgres://novel:novel@localhost:5433/novel
OPENROUTER_API_KEY=sk-or-...
DEFAULT_MODEL=anthropic/claude-sonnet-4.5
PORT=3000
JWT_SECRET=change-me
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin1234
MAX_OUTPUT_TOKENS=16000
UPLOAD_DIR=
NODE_ENV=
CORS_ORIGIN=
ALLOW_REGISTRATION=true
MONTHLY_BUDGET_USD=
CHECK_MODEL=
PUBLIC_URL=
SUMMARY_MODEL=
LOCAL_BASE_URL=
LOCAL_API_KEY=

# Shown in the Terms / Privacy / Contact pages ({{operator}}, {{contactEmail}}) until an admin sets them at /admin/site
OPERATOR_NAME=
CONTACT_EMAIL=

# Writers put their own OpenRouter key in their profile; it is stored encrypted with a key derived from this secret.
# Defaults to JWT_SECRET. Changing it makes stored keys unreadable (writers re-enter them), so keep it stable.
KEY_ENCRYPTION_SECRET=
